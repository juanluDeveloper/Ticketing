# Plantilla. Copiar a /srv/ticketing/deploy/.env y rellenar con valores propios.
# El .env real NUNCA va al repositorio.
#
#   cp .env.example .env && chmod 600 .env

# --- Base de datos -----------------------------------------------------------
# Nombre y volumen propios: no se reutiliza nada de Videogames Library.
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
# Generar una de verdad:  openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAME

# --- Usuario de la aplicación ------------------------------------------------
# Se hashea con BCrypt en el primer arranque, cuando el hash está en el
# centinela NEEDS_INIT. En claro no se guarda nunca.
# Esto va a estar publicado en internet: que no sea "cambiame".
SEED_USER_PASSWORD=CAMBIAME

# --- Almacenamiento ----------------------------------------------------------
# Las imágenes originales de los tickets. Van fuera del volumen de Docker para
# que entren en la copia de seguridad con el resto de datos del proyecto.
TICKETING_STORAGE=/srv/ticketing/storage

# --- Puerto del host ---------------------------------------------------------
# NO 8080: lo ocupa el nginx de Videogames Library.
# Confirmar que está libre antes:  sudo ss -ltnp | grep 8081
HOST_PORT=8081

# --- Ollama ------------------------------------------------------------------
# Corre en el host con la GTX 1070, no en un contenedor.
OLLAMA_MODEL=qwen3-vl:8b
# Mismo valor que en desarrollo: si difieren, lo medido en el PC no predice lo
# que pasará aquí. En 8 GB de VRAM este es el número a vigilar.
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=900
